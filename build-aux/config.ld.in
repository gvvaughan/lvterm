-- -*- lua -*-
title = "@package@ @version@ Reference"
project = "@package@ @version@"
description = "Virtual terminal for Lua"

tparam_alias "string"
tparam_alias "int"
tparam_alias "bool"

dir = "../doc/api"
file = {
  -- Modules
  "../lib/lvterm/init.lua",
  "../lib/lvterm/terminal.lua",
  "../lib/lvterm/ffi.lua",
  "../lib/lvterm/version.lua.in",
}

boilerplate = true
backtick_references = false
format = "markdown"
merge = true
sort = true
