--- What the build found out about this host.
--
-- Made from `config.lua.in` when LuaRocks builds the rock, with the
-- directory that it found libvterm in.
--
-- @module lvterm.config

return {
   --- Where LuaJIT can load libvterm from.
   -- @field library
   library = '@VTERM_LIBDIR@/libvterm.@VTERM_SOEXT@',
}
